# Copy this file to .env (git-ignored) and fill in what you need. Never commit .env.
# Every value can also be set as a regular environment variable instead.

# --- Which model provider to use ---------------------------------------------------------
# One of: anthropic | openai | google | groq | ollama
# Install its integration once with:  uv sync --extra <provider>
DOCSHELP_PROVIDER=anthropic

# Optional: override the provider's default model and its smaller "fast" model (used in stage 1).
DOCSHELP_MODEL=
DOCSHELP_FAST_MODEL=
# DOCSHELP_MAX_TOKENS=4096

# --- API keys: only the one for your chosen provider is needed ------------------------------
# Anthropic (paid):          https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI (paid):             https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini (free tier): https://aistudio.google.com/apikey   (GEMINI_API_KEY also works)
GOOGLE_API_KEY=
# Groq (free tier):          https://console.groq.com/keys
GROQ_API_KEY=
# Ollama (free, local, no key): https://ollama.com/download. Change only if Ollama runs elsewhere.
OLLAMA_BASE_URL=http://localhost:11434

# --- LangSmith: optional, free tier is enough ------------------------------------------------
# https://smith.langchain.com → Settings → API Keys. Traces every stage automatically.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docshelp-demo
# EU accounts: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Embeddings (local, free, any provider) --------------------------------------------------
# DOCSHELP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
